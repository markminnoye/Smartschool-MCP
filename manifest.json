{
  "manifest_version": "0.4",
  "name": "smartschool-mcp",
  "display_name": "Smartschool",
  "version": "0.3.0-test.1",
  "description": "Rooster, punten, taken en berichten van Smartschool voor één kind.",
  "long_description": "Claude Desktop-extensie voor het Smartschool-portaal. De server start via uv en praat via stdio. Vul school, gebruikersnaam, wachtwoord, geboortedatum en de naam van je kind in via Configure. Die gegevens worden eenmalig bewaard in ~/.config/smartschool/credentials.json (op een Mac het wachtwoord in de Sleutelhanger). Staat dat profiel er al, dan wint dat bestand en maakt Configure geen tweede kopie.",
  "author": {
    "name": "Mauro Druwel",
    "email": "mauro.druwel@gmail.com",
    "url": "https://github.com/MauroDruwel/Smartschool-MCP"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MauroDruwel/Smartschool-MCP"
  },
  "homepage": "https://github.com/MauroDruwel/Smartschool-MCP",
  "documentation": "https://github.com/MauroDruwel/Smartschool-MCP/blob/main/docs/claude-desktop-test.md",
  "support": "https://github.com/MauroDruwel/Smartschool-MCP/issues",
  "server": {
    "type": "uv",
    "entry_point": "smartschool_mcp/__main__.py",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--directory",
        "${__dirname}",
        "python",
        "-m",
        "smartschool_mcp"
      ],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "SMARTSCHOOL_MAIN_URL": "${user_config.school}",
        "SMARTSCHOOL_USERNAME": "${user_config.username}",
        "SMARTSCHOOL_PASSWORD": "${user_config.password}",
        "SMARTSCHOOL_MFA": "${user_config.birth_date}",
        "SMARTSCHOOL_CHILD_NAME": "${user_config.child_name}"
      }
    }
  },
  "tools": [
    {
      "name": "get_courses",
      "description": "Vakken met leerkrachten"
    },
    {
      "name": "get_course_documents",
      "description": "Documenten bij een vak"
    },
    {
      "name": "download_course_document",
      "description": "Download een document bij een vak"
    },
    {
      "name": "get_results",
      "description": "Punten"
    },
    {
      "name": "get_future_tasks",
      "description": "Taken die nog moeten"
    },
    {
      "name": "get_messages",
      "description": "Berichten"
    },
    {
      "name": "get_schedule",
      "description": "Rooster van één dag"
    },
    {
      "name": "get_periods",
      "description": "Periodes van het schooljaar"
    },
    {
      "name": "get_reports",
      "description": "Rapporten"
    },
    {
      "name": "get_planned_elements",
      "description": "Planner over meerdere dagen"
    },
    {
      "name": "get_planner_attachments",
      "description": "Bijlagen bij een planneritem"
    },
    {
      "name": "download_planner_file",
      "description": "Download een plannerbijlage"
    },
    {
      "name": "get_student_support_links",
      "description": "Links voor leerlingenbegeleiding"
    },
    {
      "name": "get_children",
      "description": "Kinderen op Mijn kinderen"
    },
    {
      "name": "switch_child",
      "description": "Wissel naar een gekoppeld kind"
    },
    {
      "name": "get_attachments",
      "description": "Bijlagen bij een bericht"
    },
    {
      "name": "download_attachment",
      "description": "Download een bijlage"
    },
    {
      "name": "get_homepage_blocks",
      "description": "Blokken in de kijker op de startpagina"
    },
    {
      "name": "download_homepage_image",
      "description": "Download een foto uit een startpaginablok"
    }
  ],
  "user_config": {
    "school": {
      "type": "string",
      "title": "School",
      "description": "Subdomein van de school, bijvoorbeeld dering of depass",
      "required": false
    },
    "username": {
      "type": "string",
      "title": "Gebruikersnaam",
      "description": "Smartschool-gebruikersnaam",
      "required": false
    },
    "password": {
      "type": "string",
      "title": "Wachtwoord",
      "description": "Smartschool-wachtwoord. Eenmalig bewaard, niet in het chatvenster.",
      "required": false,
      "sensitive": true
    },
    "birth_date": {
      "type": "string",
      "title": "Geboortedatum van het kind",
      "description": "jjjj-mm-dd",
      "required": false,
      "sensitive": true
    },
    "child_name": {
      "type": "string",
      "title": "Naam van het kind",
      "description": "De naam waarmee Claude het kind kiest",
      "required": false
    }
  },
  "keywords": ["smartschool", "school", "planner", "cijfers"],
  "license": "MIT",
  "compatibility": {
    "platforms": ["darwin", "win32", "linux"],
    "runtimes": {
      "python": ">=3.10"
    }
  }
}
