+def _as_text(value: object) -> str:
+    if isinstance(value, str):
+        return value.strip()
+    return ""
+
+
+def _as_id(value: object) -> str:
+    if value is None or isinstance(value, bool):
+        return ""
+    if isinstance(value, (str, int)):
+        return str(value).strip()
+    return ""
+
+
+def _as_size(value: object) -> int | None:
+    if isinstance(value, bool) or value is None:
+        return None
+    if isinstance(value, int):
+        return value
+    if isinstance(value, str) and value.strip().isdigit():
+        return int(value.strip())
+    return None
+
+
+def _first_text(data: dict, *keys: str) -> str:
+    for key in keys:
+        text = _as_text(data.get(key))
+        if text:
+            return text
+    return ""
+
+
+def _first_list(data: dict, *keys: str) -> list | None:
+    for key in keys:
+        value = data.get(key)
+        if isinstance(value, list):
+            return value
+    return None
+
+
+def _normalize_upload_file(raw: dict) -> dict:
+    revision = raw.get("currentRevision") if isinstance(raw.get("currentRevision"), dict) else {}
+    links = raw.get("links") if isinstance(raw.get("links"), dict) else {}
+    download = _first_text(raw, "downloadUrl", "downloadLink", "download_url", "href", "url")
+    if not download:
+        download = _first_text(links, "download", "downloadUrl", "href")
+    mime = _first_text(raw, "mimeType", "mime", "contentType") or _first_text(revision, "mimeType", "mime")
+    size = raw.get("size", raw.get("fileSize", revision.get("fileSize")))
+    revision_id = raw.get("currentRevisionId") or revision.get("id") or raw.get("revisionId")
+    return {
+        "id": _as_id(raw.get("id", raw.get("fileId"))),
+        "name": _first_text(raw, "name", "filename", "fileName", "title"),
+        "mimeType": mime,
+        "size": _as_size(size),
+        "downloadUrl": download,
+        "revisionId": _as_id(revision_id),
+    }
+
+
+def _looks_like_file(raw: dict) -> bool:
+    if _first_list(raw, "files", "uploads", "items", "attachments") is not None:
+        return False
+    if _first_text(raw, "filename", "fileName", "downloadUrl", "downloadLink", "download_url", "href", "url", "mimeType", "mime", "contentType"):
+        return True
+    return bool(raw.get("fileId") or raw.get("currentRevision") or raw.get("currentRevisionId"))
+
+
+def _coerce_folder_list(value: object) -> list:
+    if isinstance(value, list):
+        return value
+    if not isinstance(value, dict):
+        return []
+    nested = _first_list(value, "folders", "uploadFolders", "items", "data", "files", "uploads")
+    if nested is not None and _first_list(value, "files", "uploads", "items", "attachments") is not None and "id" in value:
+        return [value]
+    if nested is not None:
+        return nested
+    return [value]
+
+
+def _normalize_upload_folders(value: object) -> list[dict]:
+    """Map an unverified upload-folder payload onto PlannerUploadFolder dicts."""
+    folders: list[dict] = []
+    loose_files: list[dict] = []
+    for raw in _coerce_folder_list(value):
+        if not isinstance(raw, dict):
+            continue
+        file_list = _first_list(raw, "files", "uploads", "items", "attachments")
+        if file_list is None:
+            if _looks_like_file(raw):
+                loose_files.append(_normalize_upload_file(raw))
+            elif _as_id(raw.get("id")):
+                folders.append(
+                    {
+                        "id": _as_id(raw.get("id")),
+                        "name": _first_text(raw, "name", "title"),
+                        "files": [],
+                    }
+                )
+            continue
+        folders.append(
+            {
+                "id": _as_id(raw.get("id")),
+                "name": _first_text(raw, "name", "title"),
+                "files": [_normalize_upload_file(item) for item in (file_list or []) if isinstance(item, dict)],
+            }
+        )
+    if loose_files:
+        folders.append({"id": "", "name": "", "files": loose_files})
+    return folders
+
+
+def prepare_planned_element(payload: dict) -> dict:
+    """
+    Copy a planner JSON object and keep description plus upload folders.
+
+    ``PlannedElement`` ignores unknown keys. Captured calendar fixtures have
+    neither ``description`` nor ``uploadFolders``. The website asks for
+    ``includes=upload-folders``; this keeps those keys when a live response
+    sends them, under several likely names. A shape we do not understand
+    becomes an empty folder list instead of failing the whole calendar parse.
+
+    The exact live key names are not verified against a logged-in portal.
+    """
+    if not isinstance(payload, dict):
+        return {}
+    data = dict(payload)
+
+    public_info = data.get("publicInfo")
+    if isinstance(public_info, str) and public_info.strip():
+        data["publicInfo"] = public_info.strip()
+    else:
+        data.pop("publicInfo", None)
+        public_info = ""
+
+    description = data.get("description")
+    if not isinstance(description, str) or not description.strip():
+        description = public_info or ""
+        if not description:
+            for key in ("descr", "content", "info", "remarks"):
+                candidate = data.get(key)
+                if isinstance(candidate, str) and candidate.strip():
+                    description = candidate.strip()
+                    break
+    else:
+        description = description.strip()
+
+    if description:
+        data["description"] = description
+    else:
+        data.pop("description", None)
+
+    raw_folders = None
+    for key in ("uploadFolders", "upload_folders", "attachments"):
+        if key in data:
+            raw_folders = data.get(key)
+            break
+    data.pop("uploadFolders", None)
+    data.pop("upload_folders", None)
+    # ``attachments`` is not a PlannedElement field. Drop it so a non-list
+    # value cannot be confused with a future required field, and so a list of
+    # files is re-attached only via uploadFolders.
+    data.pop("attachments", None)
+    if raw_folders is not None:
+        data["uploadFolders"] = _normalize_upload_folders(raw_folders)
+    return data
+
+
+def load_planned_assignment(session: Smartschool, platform_id: int, assignment_id: str) -> PlannedElement | None:
+    """
+    GET ``/planner/api/v1/planned-assignments/{platformId}/{assignmentId}``.
+
+    The path is in the portal catalog (assignment detail opened from Planner).
+    No captured fixture stores the response body, so a missing route or a
+    payload that is not one planned element returns None.
+    """
+    path = f"/planner/api/v1/planned-assignments/{platform_id}/{assignment_id}"
+    try:
+        payload = session.json(path)
+    except Exception:
+        # Path is catalogued; the body and error page are not in the fixtures.
+        return None
+    if not isinstance(payload, dict):
+        return None
+    try:
+        return PlannedElement(**prepare_planned_element(payload))
+    except Exception:
+        return None
+
