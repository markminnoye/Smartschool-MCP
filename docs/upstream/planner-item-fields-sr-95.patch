+        {
+            "id": "folder-1",
+            "name": "Bijlagen",
+            "files": [
+                {
+                    "id": "file-1",
+                    "filename": "oefening.pdf",
+                    "mimeType": "application/pdf",
+                    "fileSize": 1200,
+                    "downloadUrl": "/planner/api/v1/files/file-1/download",
