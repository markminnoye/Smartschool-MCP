# Copy this file to config.env in the same directory and fill in one account.
# config.env is gitignored. Do not commit passwords or birth dates.
#
# SMARTSCHOOL_MAIN_URL is the school host only (no https://).
# SMARTSCHOOL_MFA is the account-verification birth date (YYYY-MM-DD), or the
# Google Authenticator secret when the school uses that. The library requires it.

SMARTSCHOOL_MAIN_URL=school.smartschool.be
SMARTSCHOOL_USERNAME=
SMARTSCHOOL_PASSWORD=
SMARTSCHOOL_MFA=
